            "arrow": "ArrowUp"
          },
          "chair_back": {
            "label": "Backward",
            "gesture": "pull",
            "arrow": "ArrowDown"
          },
          "chair_left": {
            "label": "Left",
            "gesture": "left",
            "arrow": "ArrowLeft"
          },
          "chair_right": {
            "label": "Right",
            "gesture": "right",
            "arrow": "ArrowRight"
          },
          "chair_stop": {
            "label": "Stop",
            "gesture": "left+right",
            "arrow": "ArrowLeft+ArrowRight"
          },
          "chair_left360": {
            "label": "Left 360",
