# Independent of existing MQTT_HOST and hardware broker settings.
BCI_MOBILE_MQTT_HOST=52.21.249.6
BCI_MOBILE_MQTT_PORT=1883
BCI_MOBILE_MQTT_TLS=false
BCI_MOBILE_MQTT_USERNAME=
BCI_MOBILE_MQTT_PASSWORD=
BCI_MOBILE_COMMANDS_TOPIC=masterhub/mobile/MOBILE_001/command
BCI_MOBILE_ACK_TOPIC=masterhub/mobile/MOBILE_001/ack
BCI_MOBILE_MEDIA_TOPIC=masterhub/mobile/MOBILE_001/media
BCI_MOBILE_STATUS_TOPIC=masterhub/mobile/MOBILE_001/status
BCI_MOBILE_HEARTBEAT_TOPIC=masterhub/mobile/MOBILE_001/heartbeat
BCI_MOBILE_CONTROL_TOPIC=masterhub/mobile/MOBILE_001/control
BCI_MOBILE_ACK_TIMEOUT=8
BCI_MOBILE_HEARTBEAT_TIMEOUT=35
BCI_MOBILE_TOPIC_PREFIX=masterhub/mobile/MOBILE_001
BCI_MOBILE_ERROR_TOPIC=masterhub/mobile/MOBILE_001/error

# Account/device API: SQLite defaults to data/masterhub.db.
# MASTERHUB_DATABASE=D:/GALATICX/masterhub_iot_noushith/data/masterhub.db
# Optional externally reachable broker URI returned to registered phones.
# BCI_MOBILE_PUBLIC_MQTT_URI=ssl://broker.example.com:8883
# Optional PHONE credentials; never distribute the backend broker administrator credentials.
BCI_MOBILE_DEVICE_MQTT_USERNAME=
BCI_MOBILE_DEVICE_MQTT_PASSWORD=

# Android 0.5 MQTT discovery uses bci/devices/register and bci/{uuid}/... .
# It uses the existing mobile broker host/port/TLS settings above.
# Legacy per-topic settings above continue to apply only to legacy devices.
