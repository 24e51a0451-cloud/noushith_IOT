# Copy to .env for local development only. Never commit real credentials.
# Inject credentials through the deployment environment in production.
CORTEX_CLIENT_ID=
CORTEX_CLIENT_SECRET=
CORTEX_URL=wss://localhost:6868
CORTEX_STREAM_NAME=com
CORTEX_SESSION_STATUS=active
PREDICTION_SOURCE=cortex

# Default to this computer only. Set an explicit LAN address for remote devices.
MASTERHUB_HOST=127.0.0.1
MASTERHUB_PORT=5000
# Required by serve.py. Browser prompts for these operator credentials.
# Use a unique random password of at least 32 characters; remote access requires HTTPS.
MASTERHUB_OPERATOR_USER=operator
MASTERHUB_OPERATOR_PASSWORD=

# PostgreSQL server connection (server-only; never put the password in Android/JS).
PGHOST=localhost
PGPORT=5432
PGDATABASE=masterhub
PGUSER=masterhub_app
PGPASSWORD=
# Optional full PostgreSQL connection URL overrides the PG settings above.
DATABASE_URL=

# Keep this unique per Masterhub installation and unchanged when moving hosts.
MASTERHUB_INSTANCE_ID=masterhub-main
# Pending event files, retried automatically when PostgreSQL returns.
# MASTERHUB_EVENT_SPOOL=data/event-outbox
